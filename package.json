{
  "name": "neobank-mini-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "bot": "tsx --env-file=.env bot/index.ts",
    "tunnel": "ssh -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -R 80:127.0.0.1:4173 nokey@localhost.run",
    "tunnel:lt": "npx --yes localtunnel --port 4173",
    "tunnel:cf": "cloudflared tunnel --url http://127.0.0.1:4173"
  },
  "dependencies": {
    "grammy": "^1.38.3",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "localtunnel": "^2.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
